#!/usr/bin/env bash
# omarchy-drawer CLI control interface
set -euo pipefail

TARGET="evcode.drawer"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HELPER="$SCRIPT_DIR/drawer-helper"

usage() {
  cat << 'EOF'
Usage: omarchy-drawer [COMMAND] [ARGS]

Commands:
  toggle [plugin_id]       Toggle drawer open/closed, or launch/toggle a specific plugin
  open                     Open the drawer panel
  close                    Close the drawer panel
  list                     List plugins currently inside the drawer
  bar-items                List widgets currently on the Omarchy status bar
  launch <plugin_id>       Launch/toggle a specific plugin inside the drawer
  add <plugin_id>          Hide widget from top bar and move it into drawer
  remove <plugin_id>       Restore widget from drawer back to top bar
  set-anchor <anchor>      Set popout alignment (drawer-left, drawer-center, icon)
  help, -h, --help         Show this message
EOF
}

cmd="${1:-toggle}"

case "$cmd" in
  toggle)
    if [[ -n "${2:-}" ]]; then
      omarchy-shell "$TARGET" launch "$2"
    else
      omarchy-shell "$TARGET" toggle
    fi
    ;;
  open|show)
    omarchy-shell "$TARGET" open
    ;;
  close|hide)
    omarchy-shell "$TARGET" close
    ;;
  list)
    omarchy-shell "$TARGET" list
    ;;
  bar-items)
    "$HELPER" list-bar-items
    ;;
  launch|open-plugin)
    [[ -n "${2:-}" ]] || { echo "Error: Missing plugin_id" >&2; exit 1; }
    omarchy-shell "$TARGET" launch "$2"
    ;;
  add|hide-from-bar)
    [[ -n "${2:-}" ]] || { echo "Error: Missing plugin_id" >&2; exit 1; }
    "$HELPER" hide-from-bar "$2"
    omarchy-shell "$TARGET" add "$2"
    ;;
  remove|restore-to-bar)
    [[ -n "${2:-}" ]] || { echo "Error: Missing plugin_id" >&2; exit 1; }
    "$HELPER" restore-to-bar "$2"
    omarchy-shell "$TARGET" remove "$2"
    ;;
  set-anchor)
    [[ -n "${2:-}" ]] || { echo "Error: Missing anchor (drawer-left, drawer-center, icon)" >&2; exit 1; }
    "$HELPER" set-popout-anchor "$2"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
