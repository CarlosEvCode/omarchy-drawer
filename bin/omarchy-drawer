#!/usr/bin/env bash
# omarchy-drawer CLI control interface
set -euo pipefail

TARGET="evcode.drawer"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HELPER="$SCRIPT_DIR/drawer-helper"

usage() {
  cat << 'EOF'
Usage: omarchy-drawer [COMMAND] [ARGS]

Commands:
  toggle                   Toggle the drawer open/closed state
  open                     Open the drawer
  close                    Close the drawer
  list                     List items currently inside the drawer
  bar-items                List items currently on the Omarchy status bar
  add <plugin_id>          Add a plugin into the drawer
  remove <plugin_id>       Remove a plugin from the drawer
  hide-from-bar <id>       Hide widget from top bar and move it into drawer
  restore-to-bar <id>      Restore widget from drawer back to top bar
  settings                 Open the drawer settings popup
  help, -h, --help         Show this message
EOF
}

cmd="${1:-toggle}"

case "$cmd" in
  toggle)
    omarchy-shell "$TARGET" toggle
    ;;
  open)
    omarchy-shell "$TARGET" open
    ;;
  close)
    omarchy-shell "$TARGET" close
    ;;
  list)
    omarchy-shell "$TARGET" list
    ;;
  bar-items)
    "$HELPER" list-bar-items
    ;;
  add)
    [[ -n "${2:-}" ]] || { echo "Error: Missing plugin_id" >&2; exit 1; }
    omarchy-shell "$TARGET" add "$2"
    ;;
  remove)
    [[ -n "${2:-}" ]] || { echo "Error: Missing plugin_id" >&2; exit 1; }
    omarchy-shell "$TARGET" remove "$2"
    ;;
  hide-from-bar)
    [[ -n "${2:-}" ]] || { echo "Error: Missing plugin_id" >&2; exit 1; }
    "$HELPER" hide-from-bar "$2"
    omarchy-shell "$TARGET" add "$2"
    ;;
  restore-to-bar)
    [[ -n "${2:-}" ]] || { echo "Error: Missing plugin_id" >&2; exit 1; }
    "$HELPER" restore-to-bar "$2"
    omarchy-shell "$TARGET" remove "$2"
    ;;
  settings)
    omarchy-shell "$TARGET" manage
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
